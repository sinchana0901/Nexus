{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEXUS Hybrid Task Contract v2",
  "type": "object",
  "required": [
    "session_id", "timestamp", "trigger",
    "routing_metadata", "tasks",
    "confidence_score", "requires_approval"
  ],
  "properties": {
    "session_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "trigger": { "type": "string" },

    "routing_metadata": {
      "type": "object",
      "required": ["sentinel_decision", "inference_used", "sensitive_entities_found"],
      "properties": {
        "sentinel_decision": {
          "type": "string",
          "enum": ["groq", "local"],
          "description": "What Layer 1 decided"
        },
        "inference_used": {
          "type": "string",
          "enum": ["groq", "ollama", "cache"],
          "description": "What Layer 2 actually used"
        },
        "sensitive_entities_found": {
          "type": "integer",
          "description": "How many sensitive entities Sentinel detected"
        },
        "anonymization_applied": { "type": "boolean" },
        "sentinel_latency_ms": { "type": "integer" },
        "executor_latency_ms": { "type": "integer" }
      }
    },

    "context_snapshot": {
      "type": "object",
      "properties": {
        "memory_sections_used": {
          "type": "array",
          "items": { "type": "string" }
        },
        "soul_constraints_applied": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "node", "action", "payload", "priority"],
        "properties": {
          "task_id": { "type": "string" },
          "node": {
            "type": "string",
            "enum": ["comms", "calendar", "finance", "geo", "system"]
          },
          "action": { "type": "string" },
          "payload": { "type": "object" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "estimated_cost": { "type": "number" },
          "rollback_action": { "type": ["object", "null"] }
        }
      }
    },

    "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "requires_approval": { "type": "boolean" },
    "approval_reason": { "type": "string" },
    "total_estimated_cost": { "type": "number" }
  }
}